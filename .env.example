# Copy this file to ".env" and edit.
# SOURCE=demo   -> generates realistic sample "Amazon" orders (works offline)
# SOURCE=spapi  -> pulls real orders from YOUR Amazon seller account
SOURCE=demo
PORT=5000

# Only needed when SOURCE=spapi (Amazon Selling Partner API)
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REFRESH_TOKEN=
MARKETPLACE_ID=A21TJRUUN4KGV
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
